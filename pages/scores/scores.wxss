

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 24rpx;
  font-weight: 500;
}

.stat-item {
  background-color: white;
  width: calc(50% - 23rpx);
  padding: 16rpx 0px;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
}