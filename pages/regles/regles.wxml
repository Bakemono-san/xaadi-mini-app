<view class="page">
  <nav-bar title="Règles" showBack />

  <scroll-view scroll-y style="height: 100vh;">

    <view class=" p-6 flex flex-col gap-4 ">

      <view wx:for="{{rules}}" wx:key="index" class="bg-white flex flex-col justify-start gap-2 rounded-md shadow-lg p-6">
        <text class="text-lg p-none font-bold">
          {{index}}
        </text>

        <view wx:for="{{item.details}}" wx:key="*this" class="text-sm text-black">
          {{item.list_type != "" && item.list_type != "index" ? item.list_type : item.list_type == "" ? "" : index }} {{item}}
        </view>

      </view>

      <view class="flex flex-col gap-4 pt-6">
        <menu-btn background="bg-turquoise" title="commencer a jouer" bind:tap="start" />
        <menu-btn title="retour a l'acceuil" bind:tap="goBack"/>
      </view>

    </view>
  </scroll-view>

</view>