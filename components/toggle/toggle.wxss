/* toggle.wxss */
.toggle {
  padding: 20rpx;
}

.toggle-track {
  width: 100rpx;
  height: 50rpx;
  background-color: #ccc;
  border-radius: 50rpx;
  position: relative;
  transition: background-color 0.3s ease;
}

.toggle-track.on {
  background-color: #4cd964;
}

.toggle-thumb {
  width: 44rpx;
  height: 44rpx;
  background-color: #fff;
  border-radius: 50%;
  position: absolute;
  top: 3rpx;
  left: 3rpx;
  transition: transform 0.3s ease;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.2);
}

.toggle-thumb.on {
  transform: translateX(50rpx);
}
