<view class="weui-navigation-bar {{extClass}}">
  <view
    class="bg-brown px-4 py-6 flex flex-col gap-4 {{ios ? 'ios' : 'android'}}"
    style="color: {{color}}; {{safeAreaTop}};"
  >
    <view style="{{leftWidth}};">
      <button class="back-btn gap-2 text-white" bindtap="back">
        <image src="/images/fleche-vers-larriere.png" class="icon" />
        <text>Retour</text>
      </button>
    </view>

    <text class="text-3xl text-white text-pacifico  " >{{title}}</text>
  </view>
</view>
